# Multilingual News Digest - Backend Configuration

# Database: SQLite for instant local dev, or replace with PostgreSQL URL
DATABASE_URL=sqlite:///./news_digest.db
# Example Postgres: postgresql+psycopg2://user:password@localhost:5432/news_digest

# NVIDIA Nemotron LLM Configuration
# Get your NVIDIA NIM API key from https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# JWT Authentication
JWT_SECRET=super-secret-news-digest-key-change-in-production-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment: 'development' or 'production'
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
