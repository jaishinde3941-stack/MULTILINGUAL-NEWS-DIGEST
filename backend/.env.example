# Multilingual News Digest - Backend Configuration

# Database: SQLite for instant local dev, or replace with PostgreSQL URL
DATABASE_URL=sqlite:///./news_digest.db
# Example Postgres: postgresql+psycopg2://user:password@localhost:5432/news_digest

# Server Port (default: 8000)
PORT=8000

# Local Ollama AI Model Configuration
# Ollama runs AI models locally (default: http://localhost:11434)
# Run `ollama pull llama3.2` to download the default model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# JWT Authentication
JWT_SECRET=super-secret-news-digest-key-change-in-production-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment: 'development' or 'production'
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
